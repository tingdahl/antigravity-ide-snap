#!/bin/sh
set -eu

APPDIR="$SNAP/usr/share/antigravity-ide"
ARCH_TRIPLET="x86_64-linux-gnu"

# Bundled libs win; host paths supply the mesa/GL/GBM/DRM stack, which must
# match the host's DRI driver module under classic confinement (bundling it
# crashes gbm_create_device).
export LD_LIBRARY_PATH="$SNAP/usr/lib/$ARCH_TRIPLET:$APPDIR:/usr/lib/$ARCH_TRIPLET:/lib/$ARCH_TRIPLET"

exec "$APPDIR/antigravity-ide" --no-sandbox "$@"